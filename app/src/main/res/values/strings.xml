    <!-- Onboarding -->
    <string name="onb_step">Step %1$d of %2$d</string>
    <string name="onb_welcome_title">Welcome to Tap2Nap</string>
    <string name="onb_welcome_body">Turn the screen off with a double tap on the home screen or the lock screen.</string>
    <string name="onb_disclosure_title">Why Tap2Nap needs Accessibility</string>
    <string name="onb_disclosure_body">Tap2Nap uses Android\'s Accessibility Service API to:\n• detect when you tap the screen (only the moment of each tap, not where you tap or what you type);\n• check whether the home screen, the app drawer, recent apps or the lock screen PIN pad is showing;\n• turn the screen off for you.\n\nTap2Nap doesn\'t collect, store or share any data, and it never reads what you type.</string>
    <string name="btn_agree">I agree, continue</string>
    <string name="btn_not_now">Not now</string>
    <string name="onb_enable_title">Turn on Tap2Nap</string>
    <string name="onb_enable_body">In Accessibility, open Tap2Nap (under Downloaded apps) and turn it on.</string>
    <string name="btn_open_accessibility">Open Accessibility settings</string>
    <string name="onb_restricted_title">Does Android say \"Restricted setting\"?</string>
    <string name="onb_restricted_body">That\'s normal for apps installed outside the Play Store. Open App info → ⋮ menu (top right) → Allow restricted settings, then try again.</string>
    <string name="onb_done_title">All set!</string>
    <string name="onb_done_body">Double tap the home screen or the lock screen to turn the screen off. You can change the options any time.</string>
